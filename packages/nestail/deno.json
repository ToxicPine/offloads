{
  "tasks": {
    "start": "deno run --node-modules-dir=auto --allow-net=0.0.0.0,127.0.0.1,localhost --allow-env --allow-read=. src/server.ts",
    "token": "deno run --allow-env src/cli.ts token"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  },
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.30",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/http": "jsr:@std/http@^1.1.1",
    "@zod/zod": "jsr:@zod/zod@^4.4.3"
  }
}
